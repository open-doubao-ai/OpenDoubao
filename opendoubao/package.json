{
  "name": "@a2api/opendoubao",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "dev:watch": "tsx watch server/index.ts",
    "build": "tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "tsx --test server/chat-mode.test.ts server/api-reuse.test.ts server/schema-resolve.test.ts client/smart-image-fields.test.ts client/layout-actions.test.ts client/layout-purchase.test.ts client/layout-address.test.ts client/fk-nav.test.ts client/layout-filter.test.ts",
    "start": "node dist-server/index.js"
  },
  "dependencies": {
    "@a2api/protocol": "*",
    "@a2api/runtime": "*",
    "@hono/node-server": "^1.14.4",
    "echarts": "^5.6.0",
    "hono": "^4.8.3",
    "html-to-image": "^1.11.13",
    "i18next": "^26.3.6",
    "quill": "^2.0.3",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^22.15.32",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
